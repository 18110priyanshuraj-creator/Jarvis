NODE_ENV=development
PORT=3000
# Choose a long, unique password. Never commit the real .env file.
JARVIS_PASSWORD=replace-with-a-long-random-password
# Optional data directory. Cloud free-tier storage may be ephemeral.
JARVIS_DATA_DIR=./data

# Independent AI brain: any server-configured OpenAI-compatible chat-completions endpoint.
# Keep the API key in private hosting environment variables; never commit a real key.
# Production endpoints must use HTTPS and an API key. Localhost HTTP is development/test only.
JARVIS_AI_BASE_URL=
JARVIS_AI_API_KEY=
JARVIS_AI_MODEL=
JARVIS_AI_ENABLED=false
JARVIS_AI_CHAT_ENABLED=false
JARVIS_AI_PLANNER_ENABLED=false
JARVIS_AI_REQUEST_TIMEOUT_MS=25000
JARVIS_AI_RETRY_ATTEMPTS=2

# Provider-independent live web search through a trusted SearXNG JSON endpoint.
# Production endpoint must use HTTPS. A bearer token is optional for private instances.
JARVIS_SEARCH_BASE_URL=
JARVIS_SEARCH_API_KEY=
JARVIS_SEARCH_ENABLED=false
JARVIS_SEARCH_TIMEOUT_MS=12000
JARVIS_SEARCH_RETRY_ATTEMPTS=2
JARVIS_SEARCH_MAX_RESULTS=8
JARVIS_SEARCH_LANGUAGE=all

# Optional read-only connected services. Keep real values in private server environment settings.
# GitHub: fine-grained token with Metadata: read only for selected repositories.
JARVIS_GITHUB_TOKEN=

# Google Drive OAuth web application configuration.
JARVIS_GOOGLE_OAUTH_CLIENT_ID=
JARVIS_GOOGLE_OAUTH_CLIENT_SECRET=
JARVIS_GOOGLE_OAUTH_REDIRECT_URI=
# 32-byte key used for encrypted OAuth refresh-token storage.
# Generate privately with: openssl rand -base64 32. Back it up securely; never commit it.
JARVIS_TOKEN_ENCRYPTION_KEY=
# Optional legacy short-lived access-token fallback. Prefer Google OAuth connection in the dashboard.
JARVIS_GOOGLE_DRIVE_ACCESS_TOKEN=

# Telegram bot token for profile checks and user-confirmed text messages.
JARVIS_TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs that may receive a message after explicit preview + confirmation.
# Example: 123456789,-1001234567890
JARVIS_TELEGRAM_ALLOWED_CHAT_IDS=
# ElevenLabs account summary only; no audio generation.
JARVIS_ELEVENLABS_API_KEY=

