NODE_ENV=development
PORT=3000
# Choose a long, unique password. Never commit the real .env file.
JARVIS_PASSWORD=replace-with-a-long-random-password
# Optional data directory. Cloud free-tier storage may be ephemeral.
JARVIS_DATA_DIR=./data

# Optional AI planning. Keep the real key in your host's secret environment settings only.
# Without a key, existing offline JARVIS features continue to work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional conversational replies. Set to true only when you want recent chat text sent to Gemini.
# Recent chat context is limited; saved memories, tasks, screen content and screenshots are not sent.
GEMINI_CHAT_ENABLED=false
# Live Google Search grounding is a separate opt-in feature. External search usage may incur charges.
GEMINI_WEB_RESEARCH_ENABLED=false
