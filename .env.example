NODE_ENV=development
PORT=3000
# Choose a long, unique password. Never commit the real .env file.
JARVIS_PASSWORD=replace-with-a-long-random-password
# Optional data directory. Cloud free-tier storage may be ephemeral.
JARVIS_DATA_DIR=./data

# Optional AI planning. Keep the real key in your host's secret environment settings only.
# Without a key, existing offline JARVIS features continue to work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
