NODE_ENV=development
PORT=3000
# Choose a long, unique password. Never commit the real .env file.
JARVIS_PASSWORD=replace-with-a-long-random-password
# AI backend: use gemini for Google Gemini API or ollama for a reachable Ollama server.
AI_PROVIDER=gemini
# Required when AI_PROVIDER=gemini. Set this secret in the hosting dashboard; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ollama server root URL. This must be reachable from the JARVIS server.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a model already installed on your Ollama server.
JARVIS_MODEL=qwen2.5:7b
# Optional: URL of a trusted SearXNG instance, e.g. https://search.example.com
SEARXNG_URL=
# Optional persistent data directory (attach a persistent disk in cloud hosting).
JARVIS_DATA_DIR=./data
